{
  "$schema": "https://raw.githubusercontent.com/0xKahi/pi-arsenal/main/assets/config.schema.json",
  "tmux_popup": {
    "enabled": false,
    "width": 70,
    "height": 70,
    "fileCommand": "nvim"
  },
  "p2p_council": {
    "enabled": true,
    "layout": "inline"
  },
  "multiverse": {
    "enabled": true,
    "defaultAgent": "megamind",
    "maxConcurrency": 5,
    "presets": {
      "v1": {
        "explorer": {
          "provider": "opencode-go",
          "modelId": "glm-5.3-flash",
          "reasoning": "high"
        },
        "fixer": {
          "provider": "opencode-go",
          "modelId": "deepseek-v4.1-flash",
          "reasoning": "high"
        },
        "visualizer": {
          "provider": "opencode-go",
          "modelId": "qwen3.8-flash",
          "reasoning": "medium"
        }
      }
    },
    "subagents": {
      "explorer": {
        "enabled": true,
        "model": {
          "provider": "opencode-go",
          "modelId": "glm-5.3-flash",
          "reasoning": "high"
        }
      },
      "fixer": {
        "enabled": true,
        "model": {
          "provider": "opencode-go",
          "modelId": "qwen3.8-flash",
          "reasoning": "high"
        }
      },
      "visualizer": {
        "enabled": true,
        "model": {
          "provider": "github-copilot",
          "modelId": "gemini-3.8-flash",
          "reasoning": "medium"
        }
      },
      "wiki-reader": {
        "enabled": true,
        "model": {
          "provider": "opencode-go",
          "modelId": "glm-5.3-flash",
          "reasoning": "high"
        }
      }
    }
  }
}
